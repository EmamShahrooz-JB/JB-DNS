<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.JBDNS" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ocean_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/ocean_200</item>
        <item name="colorOnPrimaryContainer">@color/ocean_900</item>
        <item name="colorSecondary">@color/ocean_600</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/ocean_100</item>
        <item name="colorOnSecondaryContainer">@color/ocean_900</item>
        <item name="colorTertiary">@color/ocean_500</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/on_surface_light</item>
        <item name="colorSurfaceVariant">@color/surface_variant_light</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_light</item>
        <item name="colorOutline">@color/outline_light</item>
        <item name="android:colorBackground">@color/surface_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="fontFamily">@font/vazirmatn</item>
        <item name="android:fontFamily" tools:targetApi="21">@font/vazirmatn</item>
    </style>

    <style name="Theme.JBDNS.Splash" parent="Theme.JBDNS">
        <item name="android:windowBackground">@color/ocean_900</item>
    </style>

    <!-- متن‌ها -->
    <style name="JbTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="JbSectionTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="JbBody" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="JbStatNumber" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="JbStatLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="JbCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
    </style>

    <style name="JbChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">14dp</item>
    </style>

</resources>
